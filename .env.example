# =============================================================================
# Hyperion - Multi-Agent Discord Bot System
# =============================================================================
# Copy this to .env and fill in your values.

# -----------------------------------------------------------------------------
# Discord Bot Tokens (one per agent)
# -----------------------------------------------------------------------------
DISCORD_TOKEN=your_vega_bot_token
ALTAIR_DISCORD_TOKEN=your_altair_bot_token
POLARIS_DISCORD_TOKEN=your_polaris_bot_token
CANOPUS_DISCORD_TOKEN=your_canopus_bot_token

# -----------------------------------------------------------------------------
# Security & Agent Registry
# -----------------------------------------------------------------------------
# Your Discord user ID (only this user can interact with the bots)
ALLOWED_USER_ID=your_discord_user_id

# Agent bot user IDs (needed for @mention dispatch between agents)
AGENT_VEGA_USER_ID=vega_bot_user_id
AGENT_ALTAIR_USER_ID=altair_bot_user_id
AGENT_POLARIS_USER_ID=polaris_bot_user_id
AGENT_CANOPUS_USER_ID=canopus_bot_user_id

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# Provider: gemini (fully implemented), openai (stub), anthropic (stub), ollama
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key
# LLM_MODEL=gemini-2.5-flash-preview-05-20

# Per-agent overrides (optional — falls back to global above)
# VEGA_LLM_MODEL=gemini-2.5-pro-preview
# ALTAIR_LLM_MODEL=gemini-2.5-flash-preview-05-20

# Utility LLM — cheap/fast model for quick evaluations (optional)
# Falls back to main LLM if not set
# UTILITY_LLM_PROVIDER=gemini
# UTILITY_LLM_MODEL=gemini-2.0-flash-lite

# Thinking LLM — reasoning model for complex tasks (optional)
# Falls back to main LLM if not set
# THINKING_LLM_PROVIDER=gemini
# THINKING_LLM_MODEL=gemini-2.5-pro-exp-03-25
# THINKING_LLM_API_KEY=  # Falls back to LLM_API_KEY

# Ollama (local models) — no API key needed
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma3:4b
# OLLAMA_BASE_URL=http://localhost:11434  # default; change for remote instances

# -----------------------------------------------------------------------------
# Orchestration (Vega)
# -----------------------------------------------------------------------------
# Max timeout cap for any single job graph node (seconds)
# JOB_MAX_TIMEOUT=600

# -----------------------------------------------------------------------------
# Terminal (Altair)
# -----------------------------------------------------------------------------
CLI_COMMAND=zsh
WORKSPACE_DIR=/path/to/workspace
TERMINAL_BACKEND=tmux
# TERMINAL_COLS=80
# TERMINAL_ROWS=24
# ALTAIR_PERMISSION_TIMEOUT=300

# -----------------------------------------------------------------------------
# Calendar (Polaris)
# -----------------------------------------------------------------------------
# Google OAuth credentials — see: https://console.cloud.google.com/
# Enable Google Calendar API, create OAuth Desktop credentials, download JSON
GOOGLE_CREDENTIALS_PATH=/path/to/credentials.json
# GOOGLE_TOKEN_PATH=~/.hyperion/polaris/token.json
# GOOGLE_CALENDAR_ID=primary
# POLARIS_TIMEZONE=America/Los_Angeles

# -----------------------------------------------------------------------------
# Browser (Canopus)
# -----------------------------------------------------------------------------
# CANOPUS_BROWSER=chromium
# CANOPUS_HEADLESS=true
# CANOPUS_VIEWPORT_WIDTH=1280
# CANOPUS_VIEWPORT_HEIGHT=720
# CANOPUS_SCREENSHOT_DIR=./screenshots

# -----------------------------------------------------------------------------
# Polaris Todo App (API server)
# -----------------------------------------------------------------------------
# JWT signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# POLARIS_APP_SECRET=your_64_char_hex_key
# POLARIS_APP_PORT=6360
# POLARIS_APP_HOST=0.0.0.0

# Web Push (VAPID) — generate with: python -m polaris.api.setup_vapid
# VAPID_PRIVATE_KEY=base64url_private_key
# VAPID_PUBLIC_KEY=base64url_public_key
# VAPID_SUBJECT=mailto:you@example.com

# CORS origins (comma-separated, dev only)
# POLARIS_CORS_ORIGINS=http://localhost:6361

# Static files directory (Next.js export, auto-detected if hyperion-app/out exists)
# POLARIS_STATIC_DIR=

# -----------------------------------------------------------------------------
# Infrastructure (optional)
# -----------------------------------------------------------------------------
# Redis enables persistence for memory, projects, conversations
# REDIS_URL=redis://localhost:6379
