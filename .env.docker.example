# Hyperion Docker Environment Configuration
# Copy this to .env and fill in your values

# ===========================================
# REQUIRED: Discord User Authorization
# ===========================================
ALLOWED_USER_ID=your_discord_user_id_here

# ===========================================
# REQUIRED: Agent Discord Tokens
# Each bot needs its own Discord application/token
# ===========================================
DISCORD_TOKEN=your_vega_discord_token
ALTAIR_DISCORD_TOKEN=your_altair_discord_token
POLARIS_DISCORD_TOKEN=your_polaris_discord_token
CANOPUS_DISCORD_TOKEN=your_canopus_discord_token

# ===========================================
# REQUIRED: LLM Configuration
# ===========================================
# Vega (conversational agent)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key
LLM_MODEL=gemini-2.0-flash

# Altair (CLI specialist)
ALTAIR_LLM_PROVIDER=gemini
ALTAIR_LLM_API_KEY=your_gemini_api_key
ALTAIR_LLM_MODEL=gemini-2.0-flash

# Polaris (calendar agent)
POLARIS_LLM_PROVIDER=gemini
POLARIS_LLM_API_KEY=your_gemini_api_key
POLARIS_LLM_MODEL=gemini-2.0-flash

# Canopus (web browser agent)
CANOPUS_LLM_PROVIDER=gemini
CANOPUS_LLM_API_KEY=your_gemini_api_key
CANOPUS_LLM_MODEL=gemini-2.0-flash

# ===========================================
# Agent Registry (for @mention communication)
# Get these from Discord after creating bot apps
# ===========================================
AGENT_VEGA_USER_ID=your_vega_bot_user_id
AGENT_ALTAIR_USER_ID=your_altair_bot_user_id
AGENT_POLARIS_USER_ID=your_polaris_bot_user_id
AGENT_CANOPUS_USER_ID=your_canopus_bot_user_id

# Main channel for collaborative agent communication
AGENT_CHANNEL_ID=your_main_channel_id

# ===========================================
# Redis (auto-configured in docker-compose)
# Only set if using external Redis
# ===========================================
# REDIS_URL=redis://localhost:6379

# ===========================================
# Altair Terminal Settings
# ===========================================
CLI_COMMAND=zsh
WORKSPACE_DIR=/workspace
TERMINAL_COLS=120
TERMINAL_ROWS=40
TERMINAL_BACKEND=tmux

# ===========================================
# Optional Settings
# ===========================================
# ALTAIR_COMMAND_PREFIX=!
# ALTAIR_PERMISSION_TIMEOUT=300
